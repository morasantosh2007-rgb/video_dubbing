# Hindi -> Telugu AI Video Dubbing Configuration

# Host and Port Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Backend API URL (for Flutter Frontend)
BACKEND_URL=http://127.0.0.1:8000

# Speech-to-Text (ASR) Configuration
# Options: "faster_whisper", "groq", "openai", "google"
ASR_PROVIDER=faster_whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Machine Translation Configuration
# Options: "mymemory", "google", "gemini", "openai", "groq"
TRANSLATION_PROVIDER=mymemory

# Text-to-Speech (TTS) Configuration
# Options: "edge-tts", "gtts"
TTS_PROVIDER=edge-tts
DEFAULT_TELUGU_VOICE=te-IN-MohanNeural
DEFAULT_FEMALE_VOICE=te-IN-ShrutiNeural

# Audio Mixing & Ambience Preservation
PRESERVE_BACKGROUND_AUDIO=true
BACKGROUND_DUCKING_DB=-12.0

# Optional API Keys (Only needed if using cloud API providers)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Upload Constraints
MAX_UPLOAD_SIZE_MB=500
